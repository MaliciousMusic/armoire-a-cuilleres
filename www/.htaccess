# L'Armoire à Cuillères — Apache (hébergement mutualisé OVH)

Options -Indexes -MultiViews
DirectoryIndex index.php
ServerSignature Off
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Une seule adresse : https://www.larmoireacuilleres.com
  RewriteCond %{HTTP_HOST} ^larmoireacuilleres\.com$ [NC]
  RewriteRule ^(.*)$ https://www.larmoireacuilleres.com/$1 [R=301,L]
  RewriteCond %{SERVER_PORT} ^80$
  RewriteCond %{HTTP_HOST} ^www\.larmoireacuilleres\.com$ [NC]
  RewriteRule ^(.*)$ https://www.larmoireacuilleres.com/$1 [R=301,L]

  # Jamais servis : fichiers cachés, code et données si le dossier app/ est posé dans www/
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule ^app(/|$) - [F,L]
  RewriteRule \.(sqlite|sqlite3|db|log|ini|sh|md|lock|bak|sql|json\.dist)$ - [F,L,NC]

  # Anciennes pages WordPress
  RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php|wp-content|wp-includes)(/|$) - [G,L]

  # Tout le reste passe par index.php (sauf les fichiers qui existent)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
  Header always unset X-Powered-By

  # Fichiers versionnés (?v=…) : un an dans le cache du navigateur
  <FilesMatch "\.(css|js|woff2|svg|webp|png|jpg|jpeg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(webmanifest|txt|xml)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType video/webm .webm
  AddType video/mp4 .mp4
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>
